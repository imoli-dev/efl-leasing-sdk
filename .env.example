#
# Example environment configuration for local development and integration tests.
# Copy this file to ".env" and fill in values appropriate for your EFL sandbox account.
#

# API key for the EFL Leasing Online sandbox environment.
EFL_API_KEY=your-sandbox-api-key

# Partner identifier used when requesting a token via /Process/GetToken.
EFL_PARTNER_ID=your-partner-id

# Optional: override base URL or environment if you need to target a non-standard endpoint.
# These are not required by the SDK but can be useful in your own tooling or examples.
EFL_BASE_URL=https://leasingonlineapi-sandbox.efl.com.pl
EFL_ENVIRONMENT=sandbox

