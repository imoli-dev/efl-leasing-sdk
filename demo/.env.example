#
# Copy this file to ".env" and fill in your EFL sandbox credentials.
#

EFL_API_KEY=your-sandbox-api-key
EFL_PARTNER_ID=your-partner-id

# Base URL for return URLs (PositiveUrlResponse, NegativeUrlResponse).
# If empty, detected from the current request. For sandbox, a public URL (e.g. ngrok)
# may be required if localhost is rejected. Example: https://abc123.ngrok.io
# EFL_BASE_URL=

# EFL sandbox frontend base (productsSearch, leaseOffer, popup.js). Default: https://leasingonline-sandbox.efl.com.pl
# EFL_SANDBOX_FRONTEND_URL=

# Optional: set to 1 to show raw API responses (on calculation results and when errors occur)
# EFL_DEBUG=1

# For deployment: if the SDK repo is private, set a GitHub token for Composer (read-only is enough).
# Example: COMPOSER_AUTH='{"github-oauth":{"github.com":"ghp_xxxxxxxxxxxx"}}'
# Or run before composer install: composer config github-oauth.github.com ghp_xxx
